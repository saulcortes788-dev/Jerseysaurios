# Referencia para el alojamiento. Flask no carga este archivo automáticamente.
# No escribas claves reales en archivos que vayas a compartir o subir a Git.
JERSEY_ENV=production
JERSEY_DATA_DIR=/var/data/jerseysaurios
JERSEY_TRUST_PROXY=1
# SECRET_KEY debe ser generada por Render (generateValue en render.yaml).
# Para un dominio propio, indicar nombres separados por coma, sin http://:
# JERSEY_TRUSTED_HOSTS=jerseysaurios.onrender.com,tu-dominio.com
